# Copy to .env and fill in. Used by docker compose and read by scheduler.py.

# --- what to crawl -----------------------------------------------------------
CRAWL_URL=https://learnwebscraping.dev/practice/ecommerce/
MAX_CONCURRENCY=3
MAX_PAGES=100

# --- when to crawl -----------------------------------------------------------
# minutes between the start of one crawl and the start of the next
CRAWL_INTERVAL_MINUTES=60
# a crawl that runs longer than this is abandoned so the schedule stays on time
RUN_TIMEOUT_MINUTES=30
# false waits one full interval before the first crawl
RUN_ON_START=true

# --- output ------------------------------------------------------------------
OUTPUT_DIR=/app/output
JSON_FILENAME=report.json
GRAPH_FILENAME=report.png
GRAPH_ENABLED=true

# --- email -------------------------------------------------------------------
EMAIL_ENABLED=false
EMAIL_FROM=crawler@example.com
# comma separated
EMAIL_TO=you@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=crawler@example.com
SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
